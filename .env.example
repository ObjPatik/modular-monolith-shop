# Supabase Database Configuration
# Replace with your own Supabase project credentials.
# In Supabase dashboard: Settings -> Database -> Connection string (URI / JDBC)
# Standard direct JDBC URL:
SPRING_DATASOURCE_URL=jdbc:postgresql://db.<your-project-ref>.supabase.co:5432/postgres?sslmode=require
# Or Supabase Transaction Pooler (port 6543):
# SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_supabase_db_password
